# DocuFlow backend configuration template
# คัดลอกเป็น backend/.env แล้วกรอกค่าจริง — ห้าม commit ไฟล์ .env ที่มีค่าจริง
# ทุกค่าในไฟล์นี้เป็นตัวอย่าง/ว่าง ไม่ใช่ค่าจริงของระบบ

# ============================================================
# 1) PUBLIC identifiers (ไม่ใช่ความลับ เบราว์เซอร์ก็เห็นค่าเหล่านี้)
#    ถ้าไม่ตั้ง จะใช้ค่าเริ่มต้นใน backend/config.js
# ============================================================
NODE_ENV=development
PORT=3000

COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=your-public-app-client-id
# (ไม่บังคับ) User Pool / App Client อื่นที่ยอมรับ token เพิ่มเติม คั่นด้วย ,
COGNITO_ALLOWED_USER_POOL_IDS=
COGNITO_ALLOWED_CLIENT_IDS=

# Origin ของ Frontend ที่อนุญาตให้เรียก API (คั่นด้วย , ไม่มี / ท้าย)
CORS_ALLOWED_ORIGINS=https://main.example.amplifyapp.com,http://localhost:3000,http://localhost:5500

TU_API_URL=https://restapi.tu.ac.th/api/v1/auth/Ad/verify

AWS_REGION=us-east-1
AWS_S3_REGION=us-east-1
S3_BUCKET=your-bucket-name

DB_HOST=your-db-host
DB_PORT=3306
DB_NAME=ems
DB_DATABASE=ems
DB_SSL=true
DB_TLS_SERVERNAME=

# ============================================================
# 2) SECRETS (ต้องตั้งผ่าน Environment เท่านั้น ห้าม hardcode ในซอร์สโค้ด)
# ============================================================
# สุ่มด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Secret สำหรับเซ็น HS256 fallback token (ถ้าว่างจะใช้ SESSION_SECRET; ยาวอย่างน้อย 16 ตัวอักษร แนะนำ 32+)
AUTH_JWT_SECRET=
# อายุ fallback token (ชั่วโมง, ค่าเริ่มต้น 8, สูงสุด 24)
AUTH_FALLBACK_TOKEN_TTL_HOURS=8

# Application-Key ของ TU REST API (ขอจากสำนักงานศูนย์คอมพิวเตอร์ มธ.)
TU_API_KEY=
# ใช้เฉพาะ Local dev: true = ข้ามการตรวจรหัสผ่าน TU (ถูกปิดอัตโนมัติเมื่อ NODE_ENV=production)
TU_AUTH_DEV_BYPASS=false

# (ไม่บังคับ) ใช้เมื่อ Cognito App Client มี Client Secret
COGNITO_CLIENT_SECRET=

DB_USER=
DB_USERNAME=
DB_PASSWORD=
# หรือใช้ AWS Secrets Manager แทน DB_USER/DB_PASSWORD
DB_SECRET_ARN=

# AWS credentials (Learner Lab) — ปล่อยว่างเมื่อรันบน Lambda ที่ใช้ IAM Role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ============================================================
# 3) Lambda deployment (scripts/deploy-aws.js)
# ============================================================
LAMBDA_DB_HOST=
LAMBDA_DB_PORT=3306
LAMBDA_DB_NAME=ems
LAMBDA_DB_SECRET_ARN=
LAMBDA_SUBNET_IDS=
LAMBDA_SECURITY_GROUP_IDS=
